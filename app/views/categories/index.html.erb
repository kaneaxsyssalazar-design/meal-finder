<h1 class="h3 mb-3">Categories</h1>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
  <% @categories.each do |category| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h5 card-title"><%= link_to category.name, category_path(category) %></h2>
          <p class="text-muted small"><%= pluralize(category.meals.size, "meal") %></p>
          <p class="card-text"><%= truncate(category.description.to_s, length: 120) %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>