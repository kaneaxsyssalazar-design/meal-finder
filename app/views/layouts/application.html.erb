<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Meal Finder</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS: gives us the grid, navbar and cards -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Kaminari's pagination links are unstyled, so we style them here -->
    <style>
      nav.pagination { display: flex; flex-wrap: wrap; gap: .35rem; justify-content: center; margin-top: 1.5rem; }
      nav.pagination a, nav.pagination span.page.current { padding: .35rem .75rem; border: 1px solid var(--bs-border-color); border-radius: .375rem; text-decoration: none; }
      nav.pagination span.page.current { background: #0d6efd; color: #fff; border-color: #0d6efd; }
      .meal-card img { height: 180px; object-fit: cover; }
    </style>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- MENU: appears on every page because it lives in the layout (2.2) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Meal Finder", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainMenu" aria-controls="mainMenu"
                aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainMenu">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Meals",       meals_path,       class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Categories",  categories_path,  class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Areas",       areas_path,       class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Ingredients", ingredients_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Tags",        tags_path,        class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "About",       about_path,       class: "nav-link" %></li>
          </ul>
          <%= link_to "Surprise me!", random_meals_path, class: "btn btn-outline-light btn-sm" %>
        </div>
      </div>
    </nav>

    <!-- Each page's content is inserted where yield is -->
    <main class="container my-4">
      <%= yield %>
    </main>

    <!-- Bootstrap JS: makes the menu collapse on phones -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>